PORT=8080
MEIDS_STORAGE_MODE=file
MEIDS_DATA_DIR=.data
ALLOWED_FRONTEND_ORIGINS=http://127.0.0.1:8601,http://localhost:8601,https://florianliepe.github.io

# Backend-only speech-to-text. Do not expose these values in frontend/runtime-config.js.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Alternative aliases for the Eraneos AI Gateway.
ERANEOS_AI_GATEWAY_API_KEY=
ERANEOS_AI_GATEWAY_BASE_URL=
ERANEOS_AI_GATEWAY_TRANSCRIPTION_MODEL=

N8N_ACTOR_TWIN_WEBHOOK_URL=
N8N_KNOWLEDGE_FABRIC_WEBHOOK_URL=
N8N_AGENTIC_BUTLER_WEBHOOK_URL=
N8N_WEBHOOK_AUTH_TOKEN=

DATABASE_URL=
DATABASE_SSL=false
